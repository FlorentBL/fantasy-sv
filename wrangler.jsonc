{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fantasy-sv",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_URL": "https://fantasy-sv.flobl.workers.dev"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fantasy-sv",
      "database_id": "da05cccf-4850-4d3d-a34d-39bff09544a8",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
